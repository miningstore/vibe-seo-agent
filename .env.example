# vibe-seo-agent runtime env. Copy to .env, edit, and source before
# running any seo_agent command:
#   set -a; source .env; set +a
# Or on the VPS, point the systemd EnvironmentFile= at this.

# --- Required: site identity ---
# GSC: exact site URL as shown in Search Console. Two formats:
#   - URL-prefix property: https://yoursite.com/   (trailing slash matters)
#   - Domain property:     sc-domain:yoursite.com  (no scheme, no path)
# Find yours: python -m seo_agent.gsc_client --list-sites
GSC_SITE_URL=https://yoursite.com/

# GA4 property ID (just the number, not "properties/").
# Find yours: python -m seo_agent.ga4_client --list-properties
GA4_PROPERTY_ID=000000000

# --- Required: Cloudflare D1 (if using D1 as the experiment store) ---
# Account ID: dashboard top-right under "Account Home" → API tokens.
CLOUDFLARE_ACCOUNT_ID=

# D1 database ID: wrangler.toml `database_id = "..."` for your D1.
CLOUDFLARE_D1_DATABASE_ID=

# D1 API token: dashboard → My Profile → API Tokens → Create Token.
# Permissions: Account → D1 → Edit. Restrict to one DB if you can.
CLOUDFLARE_D1_API_TOKEN=

# --- Claude CLI authentication ---
# By default the agent uses your Claude Pro/Max plan via OAuth — the
# `claude` CLI reads ~/.claude/.credentials.json (set up once by running
# `claude` interactively on the VPS and completing /login). NO API KEY
# IS NEEDED in this mode and it's strongly recommended (no per-token
# cost up to your plan limits).
#
# Only set ANTHROPIC_API_KEY if you specifically want to bypass plan
# auth and pay per-token. WARNING: if both are present, Claude may
# prefer the API key and you'll see unexpected charges.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Weekly digest mailer (optional but recommended) ---
# Email goes out every Monday 09:00 server-local via ForwardEmail.net.
# Idempotent per ISO week — safe if the systemd timer fires multiple times.
# SEO_DIGEST_TO=marketing@yoursite.com
# SEO_DIGEST_FROM=noreply@yoursite.com
# SEO_DIGEST_SUBJECT_PREFIX=[YourSite SEO Agent]
# FORWARD_EMAIL_API_KEY=...

# --- Optional: tune the agent ---
# Comma-separated paths to probe during health-check (default: /).
# GA4_HEALTHCHECK_PATHS=/,/about,/pricing

# Spend / iteration caps
# SEO_DAILY_SPEND_CAP_USD=15.0
# SEO_MAX_VARIANTS_PER_DAY=60
# SEO_MAX_ACTIVE_PER_SLOT=8

# Git branch where promoted winners land
# SEO_ACCEPTED_BRANCH=seo-agent/accepted

# Claude CLI options
# CLAUDE_MODEL=sonnet
# CLAUDE_TURN_CAP=30
# CLAUDE_TIMEOUT_S=600

# --- Optional: override credential paths ---
# Default: credentials/gsc-oauth-secrets.json and credentials/gsc-oauth-token.json
# GSC_OAUTH_SECRETS_FILE=credentials/gsc-oauth-secrets.json
# GSC_OAUTH_TOKEN_FILE=credentials/gsc-oauth-token.json
